# 复制成 .env 再填自己的 key（.env 已被 .gitignore 忽略，不会进仓库）
#
#   Git Bash：  cp .env.example .env
#   PowerShell：Copy-Item .env.example .env
#
# key 申请地址：https://platform.deepseek.com/

# ── 必填 ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-在这里填你自己的key

# ── 可选（不填就用默认值）───────────────────────────────
# STUDY_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# STUDY_MAX_TURNS=5
# STUDY_KEEP_MESSAGES=20
# STUDY_TIMEOUT=60
# STUDY_ENABLE_MCP=1
# STUDY_TRACE_TOOLS=1
# STUDY_LOG_LEVEL=INFO
# STUDY_NOTES_DIR=            # 留空 = 用项目里的 notes/
